<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="-- Question: total paid and items bought per customer.&#xa;-- Bug: joining OrderItems and Payments to the same order multiplies rows (items x payments),&#xa;-- so both sums are inflated, and the inner join to Payments drops customers with unpaid orders.&#xa;SELECT c.CustomerID, c.Name, SUM(p.Amount) AS TotalPaid, SUM(oi.Quantity) AS ItemsBought&#xa;FROM dbo.Customers AS c&#xa;JOIN dbo.Orders AS o ON o.CustomerID = c.CustomerID&#xa;JOIN dbo.OrderItems AS oi ON oi.OrderID = o.OrderID&#xa;JOIN dbo.Payments AS p ON p.OrderID = o.OrderID&#xa;GROUP BY c.CustomerID, c.Name&#xa;ORDER BY c.CustomerID" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900C9612C4B6ADE5E2CB70F50824FA430C00000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="3" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.0278327" StatementEstRows="3.59103" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xAF0045B865A432D9" QueryPlanHash="0x6F4E4705F0FC08AB" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="48" CompileTime="29" CompileCPU="20" CompileMemory="448"><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMemory="544" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80486" EstimatedPagesCached="40243" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="4032960"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate