<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="-- Question: orders placed in January 2026.&#xa;-- Bug: OrderDate has a time of day. BETWEEN ... AND &apos;2026-01-31&apos; stops at 2026-01-31 00:00:00,&#xa;-- so the order placed on 31 January at 16:45 is missing.&#xa;SELECT OrderID, OrderDate&#xa;FROM dbo.Orders&#xa;WHERE OrderDate BETWEEN &apos;2026-01-01&apos; AND &apos;2026-01-31&apos;&#xa;ORDER BY OrderID" StatementId="1" StatementCompId="1" StatementType="SELECT" RetrievedFromCache="true" StatementSubTreeCost="0.0032908" StatementEstRows="3" SecurityPolicyApplied="false" StatementOptmLevel="TRIVIAL" QueryHash="0x5381363883DEEF6A" QueryPlanHash="0x7C2D33EAEF7EB611" CardinalityEstimationModelVersion="160" ParameterizedText="(@1 varchar(8000),@2 varchar(8000))SELECT [OrderID],[OrderDate] FROM [dbo].[Orders] WHERE [OrderDate]&gt;=@1 AND [OrderDate]&lt;=@2 ORDER BY [OrderID] ASC"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="24" CompileTime="2" CompileCPU="2" CompileMemory="144"><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80486" EstimatedPagesCached="40243" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="4036288"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-23T21:23:09.28" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000003_3D5E1FD2]" Table="[Orders]" Schema="[dbo]" Database="[QryvantaSample]"></StatisticsInfo></OptimizerStatsUsage><RelOp NodeId="0" PhysicalOp="Clustered Index Scan" LogicalOp="Clustered Index Scan" EstimateRows="3" EstimatedRowsRead="8" EstimateIO="0.003125" EstimateCPU="0.0001658" AvgRowSize="17" EstimatedTotalSubtreeCost="0.0032908" TableCardinality="8" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Database="[QryvantaSample]" Schema="[dbo]" Table="[Orders]" Column="OrderID"></ColumnReference><ColumnReference Database="[QryvantaSample]" Schema="[dbo]" Table="[Orders]" Column="OrderDate"></ColumnReference></OutputList><IndexScan Ordered="1" ScanDirection="FORWARD" ForcedIndex="0" ForceSeek="0" ForceScan="0" NoExpandHint="0" Storage="RowStore"><DefinedValues><DefinedValue><ColumnReference Database="[QryvantaSample]" Schema="[dbo]" Table="[Orders]" Column="OrderID"></ColumnReference></DefinedValue><DefinedValue><ColumnReference Database="[QryvantaSample]" Schema="[dbo]" Table="[Orders]" Column="OrderDate"></ColumnReference></DefinedValue></DefinedValues><Object Database="[QryvantaSample]" Schema="[dbo]" Table="[Orders]" Index="[PK_Orders]" IndexKind="Clustered" Storage="RowStore"></Object><Predicate><ScalarOperator ScalarString="[QryvantaSample].[dbo].[Orders].[OrderDate]&gt;=CONVERT_IMPLICIT(datetime2(7),[@1],0) AND [QryvantaSample].[dbo].[Orders].[OrderDate]&lt;=CONVERT_IMPLICIT(datetime2(7),[@2],0)"><Logical Operation="AND"><ScalarOperator><Compare CompareOp="GE"><ScalarOperator><Identifier><ColumnReference Database="[QryvantaSample]" Schema="[dbo]" Table="[Orders]" Column="OrderDate"></ColumnReference></Identifier></ScalarOperator><ScalarOperator><Identifier><ColumnReference Column="ConstExpr1002"><ScalarOperator><Convert DataType="datetime2" Scale="7" Style="0" Implicit="1"><ScalarOperator><Identifier><ColumnReference Column="@1"></ColumnReference></Identifier></ScalarOperator></Convert></ScalarOperator></ColumnReference></Identifier></ScalarOperator></Compare></ScalarOperator><ScalarOperator><Compare CompareOp="LE"><ScalarOperator><Identifier><ColumnReference Database="[QryvantaSample]" Schema="[dbo]" Table="[Orders]" Column="OrderDate"></ColumnReference></Identifier></ScalarOperator><ScalarOperator><Identifier><ColumnReference Column="ConstExpr1003"><ScalarOperator><Convert DataType="datetime2" Scale="7" Style="0" Implicit="1"><ScalarOperator><Identifier><ColumnReference Column="@2"></ColumnReference></Identifier></ScalarOperator></Convert></ScalarOperator></ColumnReference></Identifier></ScalarOperator></Compare></ScalarOperator></Logical></ScalarOperator></Predicate></IndexScan></RelOp><ParameterList><ColumnReference Column="@2" ParameterDataType="varchar(8000)" ParameterCompiledValue="&apos;2026-01-31&apos;"></ColumnReference><ColumnReference Column="@1" ParameterDataType="varchar(8000)" ParameterCompiledValue="&apos;2026-01-01&apos;"></ColumnReference></ParameterList></QueryPlan></StmtSimple></Statements></Batch></BatchSequence></ShowPlanXML>