<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="-- Question: the customer for each order placed in January 2026.&#xa;-- Bug: the old-style comma join has no join predicate, so every order is paired with every&#xa;-- customer (a cartesian product).&#xa;SELECT o.OrderID, c.Name AS Customer&#xa;FROM dbo.Orders AS o, dbo.Customers AS c&#xa;WHERE o.OrderDate &gt;= &apos;2026-01-01&apos; AND o.OrderDate &lt; &apos;2026-02-01&apos;&#xa;ORDER BY o.OrderID, c.CustomerID" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x09005DBC63265C73197C3CA0B27DC8E1F0970000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="3" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.0072198" StatementEstRows="32" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xFDDD3BC050979E72" QueryPlanHash="0xC4747A24076C87F1" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="24" CompileTime="5" CompileCPU="5" CompileMemory="232"><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80486" EstimatedPagesCached="40243" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="4036288"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-23T21:23:09.28" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000003_3D5E1FD2]" Table="[Orders]" Schema="[dbo]" Database="[QryvantaSample]"></StatisticsInfo></Op