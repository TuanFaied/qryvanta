<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="-- Fix: count normalised email addresses. Customers without an email count individually,&#xa;-- because COUNT(DISTINCT ...) ignores NULLs.&#xa;SELECT COUNT(DISTINCT COALESCE(LOWER(TRIM(Email)), N&apos;id:&apos; + CAST(CustomerID AS nvarchar(10)))) AS Customers&#xa;FROM dbo.Customers" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x09007DC2F64E0B36B4EE426C74B826C294360000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="3" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.0146958" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x1B4B0E8B81ADEB0B" QueryPlanHash="0x3E371565A65DDD10" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="32" CompileTime="8" CompileCPU="8" CompileMemory="248"><Warnings><PlanAffectingConvert ConvertIssue="Cardinality Estimate" Expression="CONVERT(nvarchar(10),[QryvantaSample].[dbo].[Customers].[CustomerID],0)"></PlanAffectingConvert></Warnings><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMemory="544" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="80486" EstimatedPagesCached="40243" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="4036288"></OptimizerHardwareDependentProperties><RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="1" EstimateIO="0" EstimateCPU="0" AvgRowSize="11" EstimatedTotalSubtreeCost="0.0146958" Parallel